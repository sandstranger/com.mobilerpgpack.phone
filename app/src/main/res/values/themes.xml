<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="md_background_color">@color/md_background_color</item>
        <item name="md_divider_color">@color/md_divider_color</item>
        <item name="md_color_content">@color/md_color_content</item>
        <item name="md_color_title">@color/md_color_title</item>
        <item name="md_color_button_text">@color/md_color_button_text</item>
    </style>

    <style name="AppThemeDark" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="md_background_color">@color/md_background_color_dark</item>
        <item name="md_divider_color">@color/md_divider_color_dark</item>
        <item name="md_color_content">@color/md_color_content_dark</item>
        <item name="md_color_title">@color/md_color_title_dark</item>
        <item name="md_color_button_text">@color/md_color_button_text_dark</item>
    </style>

    <style name="AppFullScreenTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="md_background_color">@color/md_background_color</item>
        <item name="md_divider_color">@color/md_divider_color</item>
        <item name="md_color_content">@color/md_color_content</item>
        <item name="md_color_title">@color/md_color_title</item>
        <item name="md_color_button_text">@color/md_color_button_text</item>
    </style>

    <style name="AppFullScreenThemeDark" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="md_background_color">@color/md_background_color_dark</item>
        <item name="md_divider_color">@color/md_divider_color_dark</item>
        <item name="md_color_content">@color/md_color_content_dark</item>
        <item name="md_color_title">@color/md_color_title_dark</item>
        <item name="md_color_button_text">@color/md_color_button_text_dark</item>
    </style>
</resources>